model Tag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  quizzes QuizTag[]

  createdAt DateTime @default(now())
}

model QuizTag {
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([quizId, tagId])
}
