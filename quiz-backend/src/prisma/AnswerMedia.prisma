model AnswerMedia {
  id           String            @id @default(uuid())
  answerId     String
  type         QuestionMediaType @default(IMAGE)
  originalName String?
  storageKey   String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  order        Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId])
}
