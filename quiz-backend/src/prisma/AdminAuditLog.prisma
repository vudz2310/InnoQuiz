model AdminAuditLog {
  id          String   @id @default(uuid())
  adminId     String
  adminEmail  String
  action      String
  targetType  String?
  targetId    String?
  details     Json?
  ipAddress   String
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}
