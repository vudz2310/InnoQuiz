enum SecurityAlertSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum SecurityAlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
  FALSE_POSITIVE
}

model SecurityAlert {
  id             String                @id @default(uuid())
  type           String
  title          String
  description    String
  severity       SecurityAlertSeverity @default(WARNING)
  status         SecurityAlertStatus   @default(NEW)
  ipAddress      String?
  userId         String?
  metadata       Json?
  resolvedBy     String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@index([userId])
  @@index([ipAddress])
}
