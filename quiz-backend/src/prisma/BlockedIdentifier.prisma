enum BlockedType {
  IP
  USER
  STUDENT_CODE
}

model BlockedIdentifier {
  id           String      @id @default(uuid())
  type         BlockedType
  value        String
  reason       String
  riskScore    Int         @default(100)
  blockedUntil DateTime?
  blockedBy    String
  isActive     Boolean     @default(true)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([type, value])
  @@index([isActive])
  @@index([blockedUntil])
}
