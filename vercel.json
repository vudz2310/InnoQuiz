{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "front-end": {
      "root": "front-end",
      "framework": "vite"
    },
    "quiz-backend": {
      "root": "quiz-backend",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": { "service": "quiz-backend" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "quiz-backend" }
    },
    {
      "source": "/storage/(.*)",
      "destination": { "service": "quiz-backend" }
    },
    {
      "source": "/uploads/(.*)",
      "destination": { "service": "quiz-backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "front-end" }
    }
  ]
}
